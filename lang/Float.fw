package faswer.lang;

public const class Float with(float value) extends Object {
    public float floatValue() {
        return value;
    }

    public double doubleValue() {
        return value;
    }

    public long longValue() {
        return (long) value;
    }

    public int intValue() {
        return (int) value;
    }

    public boolean equals(object other) {
        if (!(other instanceof Float)) return false;
        Float otherFloat = (Float) other;
        return this.value == otherFloat.floatValue();
    }

    override public int hashCode() {
        return String.hashCode(toString(this.value));
    }

    public static native float parseFloat(object o);
    public static native string toString(float value);
    public static native Float valueOf(float value);
    public static native Float valueOf(string s);
}