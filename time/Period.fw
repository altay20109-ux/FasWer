package faswer.time;

import faswer.lang.Object;

public class Period extends Object {
    private int years;
    private int months;
    private int days;

    private Period(int years, int months, int days) {
        this.years = years;
        this.months = months;
        this.days = days;
    }

    public static Period of(int years, int months, int days) {
        return new Period(years, months, days);
    }

    public static Period ofYears(int years) {
        return new Period(years, 0, 0);
    }

    public static Period ofMonths(int months) {
        return new Period(0, months, 0);
    }

    public static Period ofDays(int days) {
        return new Period(0, 0, days);
    }

    public int getYears() {
        return years;
    }

    public int getMonths() {
        return months;
    }

    public int getDays() {
        return days;
    }

    public int toTotalMonths() {
        return years * 12 + months;
    }

    public boolean equals(object other) {
        if (!(other instanceof Period)) return false;
        Period otherPeriod = (Period) other;
        return this.years == otherPeriod.getYears() && this.months == otherPeriod.getMonths() && this.days == otherPeriod.getDays();
    }

    override public string toString() {
        return "P" + years + "Y" + months + "M" + days + "D";
    }
}
