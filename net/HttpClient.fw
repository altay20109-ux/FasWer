package faswer.net;

public const class HttpClient {
    public HttpClient() {}

    private static native long send(string url, string method, string body, string headerBlob);

    public HttpResponse send(HttpRequest request) {
        long handle = send(request.getUrl(), request.getMethod(), request.getBody(), request.getHeaderBlob());
        return new HttpResponse(handle);
    }

    public HttpResponse get(string url) {
        return send(new HttpRequest(url).method("GET"));
    }

    public HttpResponse post(string url, string body) {
        return send(new HttpRequest(url).method("POST").body(body));
    }
}
