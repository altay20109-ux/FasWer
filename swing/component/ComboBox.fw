package faswer.swing.component;

public class ComboBox extends Component {
    public ComboBox() {
        this.id = createComboBox(0L);
    }

    private static native long createComboBox(long windowID);

    private static native void addItem(long id, string item);
    public void addItem(string item) {
        addItem(this.id, item);
    }

    private static native void removeItem(long id, string item);
    public void removeItem(string item) {
        removeItem(this.id, item);
    }

    private static native void removeAllItems(long id);
    public void removeAllItems() {
        removeAllItems(this.id);
    }

    private static native string getSelectedItem(long id);
    public string getSelectedItem() {
        return getSelectedItem(this.id);
    }

    private static native void setSelectedIndex(long id, int index);
    public void setSelectedIndex(int index) {
        setSelectedIndex(this.id, index);
    }

    private static native int getSelectedIndex(long id);
    public int getSelectedIndex() {
        return getSelectedIndex(this.id);
    }

    private static native int getItemCount(long id);
    public int getItemCount() {
        return getItemCount(this.id);
    }

    private static native void setVisible(long id, boolean visible);
    public void setVisible(boolean visible) {
        setVisible(this.id, visible);
    }

    private static native boolean isVisible(long id);
    public boolean isVisible() {
        return isVisible(this.id);
    }

    private static native void setEnabled(long id, boolean enabled);
    public void setEnabled(boolean enabled) {
        setEnabled(this.id, enabled);
    }

    private static native boolean isEnabled(long id);
    public boolean isEnabled() {
        return isEnabled(this.id);
    }

    private static native void onClickListener(long id, object action);
    public void onClickListener(object action) {
        onClickListener(this.id, action);
    }

    private static native void onSelect(long id, object action);
    public void onSelect(object action) {
        onSelect(this.id, action);
    }
}
