package faswer.swing.component;

public class TabbedPane extends Component {
    public TabbedPane() {
        this.id = createTabbedPane(0L);
    }

    private static native long createTabbedPane(long windowID);

    private static native void addTab(long id, string title, long componentId);
    public void addTab(string title, Component component) {
        addTab(this.id, title, component.getComponent());
    }

    private static native void removeTabAt(long id, int index);
    public void removeTabAt(int index) {
        removeTabAt(this.id, index);
    }

    private static native void setSelectedIndex(long id, int index);
    public void setSelectedIndex(int index) {
        setSelectedIndex(this.id, index);
    }

    private static native int getSelectedIndex(long id);
    public int getSelectedIndex() {
        return getSelectedIndex(this.id);
    }

    private static native int getTabCount(long id);
    public int getTabCount() {
        return getTabCount(this.id);
    }

    private static native void setTitleAt(long id, int index, string title);
    public void setTitleAt(int index, string title) {
        setTitleAt(this.id, index, title);
    }

    private static native string getTitleAt(long id, int index);
    public string getTitleAt(int index) {
        return getTitleAt(this.id, index);
    }

    private static native void setToolTipAt(long id, int index, string tooltip);
    public void setToolTipAt(int index, string tooltip) {
        setToolTipAt(this.id, index, tooltip);
    }

    private static native string getToolTipAt(long id, int index);
    public string getToolTipAt(int index) {
        return getToolTipAt(this.id, index);
    }

    private static native int indexOfTab(long id, string title);
    public int indexOfTab(string title) {
        return indexOfTab(this.id, title);
    }

    private static native void setVisible(long id, boolean visible);
    public void setVisible(boolean visible) {
        setVisible(this.id, visible);
    }

    private static native boolean isVisible(long id);
    public boolean isVisible() {
        return isVisible(this.id);
    }

    private static native void setEnabled(long id, boolean enabled);
    public void setEnabled(boolean enabled) {
        setEnabled(this.id, enabled);
    }

    private static native boolean isEnabled(long id);
    public boolean isEnabled() {
        return isEnabled(this.id);
    }
}
