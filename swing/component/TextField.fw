package faswer.swing.component;

public class TextField extends Component {
    public TextField(string text) {
        this.id = createTextField(0L, text);
    }

    private static native long createTextField(long windowID, string text);

    private static native void setText(long id, string text);
    public void setText(string text) {
        setText(this.id, text);
    }

    private static native string getText(long id);
    public string getText() {
        return getText(this.id);
    }

    private static native void setColumns(long id, int columns);
    public void setColumns(int columns) {
        setColumns(this.id, columns);
    }

    private static native void setEditable(long id, boolean editable);
    public void setEditable(boolean editable) {
        setEditable(this.id, editable);
    }

    private static native boolean isEditable(long id);
    public boolean isEditable() {
        return isEditable(this.id);
    }

    private static native void setVisible(long id, boolean visible);
    public void setVisible(boolean visible) {
        setVisible(this.id, visible);
    }

    private static native boolean isVisible(long id);
    public boolean isVisible() {
        return isVisible(this.id);
    }

    private static native void setEnabled(long id, boolean enabled);
    public void setEnabled(boolean enabled) {
        setEnabled(this.id, enabled);
    }

    private static native boolean isEnabled(long id);
    public boolean isEnabled() {
        return isEnabled(this.id);
    }

    private static native void onClickListener(long id, object action);
    public void onClickListener(object action) {
        onClickListener(this.id, action);
    }

    private static native void setFont(long id, object font);
    public void setFont(object font) {
        setFont(this.id, font);
    }

    private static native object getFont(long id);
    public object getFont() {
        return getFont(this.id);
    }
}
