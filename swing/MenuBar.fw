package faswer.swing;

public class MenuBar {
    protected long id;

    public MenuBar() {
        this.id = createMenuBar();
    }

    private static native long createMenuBar();

    private static native void addMenu(long id, long menuID);
    public void addMenu(Menu menu) {
        addMenu(this.id, menu.getMenuItemID());
    }

    private static native void removeMenu(long id, long menuID);
    public void removeMenu(Menu menu) {
        removeMenu(this.id, menu.getMenuItemID());
    }

    private static native int getMenuCount(long id);
    public int getMenuCount() {
        return getMenuCount(this.id);
    }

    private static native string getMenuTitle(long id, int index);
    public string getMenuTitle(int index) {
        return getMenuTitle(this.id, index);
    }

    public long getMenuBarID() {
        return this.id;
    }
}
